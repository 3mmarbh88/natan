
import React, {
  FormEvent,
  useEffect,
  useState,
} from 'react';

import {
  Lock,
  User,
  Phone,
  Mail,
  KeyRound,
  Eye,
  EyeOff,
  ShieldCheck,
  LogIn,
  UserPlus,
  RefreshCw,
  CheckCircle2,
  AlertCircle,
  Smartphone,
  X,
} from 'lucide-react';

import {
  loginNatanUser,
  registerNatanUser,
  activateNatanUser,
  forgotNatanPassword,
  getNatanDeviceId,
  NatanActivationRequiredError,
} from '../utils/natanApi';

// ============================================================
// TYPES
// ============================================================

interface AppAuthSession {
  token: string;
  userId: string;
  username: string;
  fullName?: string;
  phone?: string;
  isAuthenticated: boolean;
  expiresAt: number;
  planName: string;
  maxDevices: number;
  createdAt?: string;
}

interface AuthModalProps {
  currentSession?: AppAuthSession | null;
  onAuthenticate: (session: AppAuthSession) => void;
  onOpenWhatsApp?: () => void;
  onClose?: () => void;
  initialTab?: AuthTab;
}

type AuthTab =
  | 'login'
  | 'register'
  | 'activate'
  | 'forgot';

// ============================================================
// HELPERS
// ============================================================

const formatExpiry = (
  timestamp?: number
) => {
  if (!timestamp) {
    return 'غير محدد';
  }

  const date = new Date(timestamp);

  if (Number.isNaN(date.getTime())) {
    return 'غير محدد';
  }

  return date.toLocaleDateString(
    'ar-BH',
    {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }
  );
};

const normalizeText = (
  value: unknown
) =>
  String(value ?? '').trim();

const normalizeCode = (
  value: unknown
) =>
  String(value ?? '')
    .trim()
    .toUpperCase();

// ============================================================
// SESSION CONVERTER
// ============================================================

const convertSession = (
  session: any
): AppAuthSession => {
  return {
    token:
      session?.token || '',

    userId:
      session?.userId ||
      session?.user?.id ||
      '',

    username:
      session?.username ||
      session?.user?.username ||
      '',

    fullName:
      session?.fullName ||
      session?.full_name ||
      session?.user?.fullName ||
      session?.user?.full_name ||
      '',

    phone:
      session?.phone ||
      session?.user?.phone ||
      session?.username ||
      '',

    isAuthenticated:
      Boolean(
        session?.isAuthenticated ??
          session?.token
      ),

    expiresAt:
      typeof session?.expiresAt ===
      'number'
        ? session.expiresAt
        : session?.expiresAt
          ? new Date(
              session.expiresAt
            ).getTime()
          : Date.now() +
            30 *
              24 *
              60 *
              60 *
              1000,

    planName:
      session?.planName ||
      session?.plan?.name ||
      'NATAN',

    maxDevices:
      Number(
        session?.maxDevices ??
          session?.max_devices ??
          session?.user?.maxDevices ??
          session?.user?.max_devices ??
          1
      ) || 1,

    createdAt:
      session?.createdAt ||
      session?.created_at ||
      session?.user?.createdAt ||
      session?.user?.created_at,
  };
};

// ============================================================
// FIELD COMPONENT
//
// مهم:
// هذا المكون خارج AuthModal.
// هذا يمنع إعادة إنشاء input أثناء الكتابة
// ويحافظ على المؤشر والتركيز.
// ============================================================

interface FieldProps {
  icon: React.ReactNode;
  label: string;
  name: string;
  value: string;
  onChange: (
    event: React.ChangeEvent<HTMLInputElement>
  ) => void;
  type?: string;
  placeholder: string;
  autoComplete?: string;
  passwordToggle?: boolean;
  showPassword?: boolean;
  setShowPassword?: (
    value: boolean
  ) => void;
  dir?: 'rtl' | 'ltr';
  inputMode?: React.HTMLAttributes<HTMLInputElement>['inputMode'];
}

const Field = React.memo(
  function Field({
    icon,
    label,
    name,
    value,
    onChange,
    type = 'text',
    placeholder,
    autoComplete,
    passwordToggle,
    showPassword,
    setShowPassword,
    dir = 'rtl',
    inputMode,
  }: FieldProps) {
    const actualType =
      passwordToggle && showPassword
        ? 'text'
        : type;

    return (
      <div className="space-y-2">
        <label
          htmlFor={name}
          className="block text-sm font-semibold text-slate-200"
        >
          {label}
        </label>

        <div className="relative">
          <div className="pointer-events-none absolute inset-y-0 right-0 flex w-12 items-center justify-center text-slate-400">
            {icon}
          </div>

          <input
            id={name}
            name={name}
            type={actualType}
            value={value}
            onChange={onChange}
            placeholder={placeholder}
            autoComplete={autoComplete}
            inputMode={inputMode}
            dir={dir}
            className="w-full rounded-2xl border border-slate-700 bg-slate-900/80 py-3.5 pr-12 pl-12 text-white outline-none transition placeholder:text-slate-500 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20"
          />

          {passwordToggle &&
            setShowPassword && (
              <button
                type="button"
                onMouseDown={(event) =>
                  event.preventDefault()
                }
                onClick={() =>
                  setShowPassword(
                    !showPassword
                  )
                }
                className="absolute inset-y-0 left-0 flex w-12 items-center justify-center text-slate-400 transition hover:text-white"
                tabIndex={-1}
                aria-label={
                  showPassword
                    ? 'إخفاء كلمة المرور'
                    : 'إظهار كلمة المرور'
                }
              >
                {showPassword ? (
                  <EyeOff size={19} />
                ) : (
                  <Eye size={19} />
                )}
              </button>
            )}
        </div>
      </div>
    );
  }
);

// ============================================================
// CODE FIELD
// ============================================================

interface CodeFieldProps {
