          كود التفعيل
        </label>

        <div className="relative">
          <div className="pointer-events-none absolute inset-y-0 right-0 flex w-12 items-center justify-center text-slate-400">
            <KeyRound size={19} />
          </div>

          <input
            id={id}
            name={name}
            type="text"
            value={value}
            onChange={onChange}
            placeholder="NATAN-XXXX-XXXX"
            autoComplete="off"
