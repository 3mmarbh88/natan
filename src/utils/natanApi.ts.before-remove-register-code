// API BASE URL
// ============================================================

export function getNatanApiBaseUrl() {
  return API_BASE_URL;
}

// ============================================================
// TOKEN STORAGE
// ============================================================

const TOKEN_STORAGE_KEY =
  'natan_auth_token';

export function saveNatanToken(
  token: string
) {
  try {
    localStorage.setItem(
      TOKEN_STORAGE_KEY,
      String(token || '')
    );
  } catch {
    // Ignore storage error
  }
}

export function getSavedNatanToken() {
  try {
    return (
      localStorage.getItem(
        TOKEN_STORAGE_KEY
      ) || ''
    );
  } catch {
    return '';
  }
}

export function clearNatanToken() {
  try {
    localStorage.removeItem(
      TOKEN_STORAGE_KEY
    );
  } catch {
    // Ignore storage error
  }
}

// ============================================================
// LOGOUT
// ============================================================

export function logoutNatan() {
  clearNatanToken();

  try {
    localStorage.removeItem(
      'natan_auth_session'
    );
  } catch {
    // Ignore
  }
}
